# Copy to .env.local. None of these are needed for the Phase 1 demo (it runs on built-in demo data).
# --- Database (Phase 2) ---
DATABASE_URL=postgresql://user:password@localhost:5432/marketing_intelligence
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=            # server only, never expose to the browser

# --- Meta Marketing API (Phase 2/3) ---
META_APP_ID=
META_APP_SECRET=                      # server only
META_API_VERSION=v27.0                # applies to every Graph API call; v27.0 is the current default
META_AD_ACCOUNT_IDS=act_1234567890    # comma separated
# --- Ad sync timing (the defaults are tuned; change only if Meta answers slowly or a pull says it ran out of time) ---
# META_TIMEOUT_MS=12000              # ordinary Graph calls: pages, chats, tokens
# META_ADS_TIMEOUT_MS=45000          # ad-account reads (/ads and /insights). A list of real creatives often needs 10-30 s;
#                                    # when our own wait is shorter, a slow answer looks like "Meta refused the field" and the
#                                    # app drops to a lighter pull - which is how ad pictures went missing.
# ADS_BUDGET_MS=120000               # how long one /api/ads-sync request keeps working before it must answer (route maxDuration 300 s)
# ADS_MEDIA_BUDGET_MS=150000         # extra time the ad-picture lookups may use; this is cut first when Meta is slow
# ADS_PAGE_SIZE=40                   # ads per page of the /ads list (lower this if Meta says "too much data")

# --- Messenger / Webhooks (Phase 2/3) ---
META_PAGE_ACCESS_TOKEN_ENCRYPTION_KEY=   # used to encrypt per-page tokens stored in DB
META_WEBHOOK_VERIFY_TOKEN=

# --- Google Sheets as the data source (set these in Vercel > Project > Settings > Environment Variables) ---
GOOGLE_SHEET_ID=                       # the long id in the sheet URL
GOOGLE_SERVICE_ACCOUNT_EMAIL=          # share the sheet with this address (Viewer, or Editor if the app writes back)
GOOGLE_PRIVATE_KEY=                    # service-account key; keep the \n line breaks, server only

# --- Sign-in (Google OAuth). Without these the app is open (demo) and refuses to serve a connected Sheet ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AUTH_SECRET=                           # 32+ random chars: openssl rand -hex 32
AUTH_ADMIN_EMAILS=                     # optional break-glass admins, comma separated
# AUTH_URL=https://your-domain         # optional; only if the redirect URI is wrong

# --- Pull chats/comments from a Facebook Page (Upload page button, Administrator only) ---
# FB_PAGE_ID=
# FB_PAGE_TOKEN=
# FB_SHEET_PAGE_ID=PG-1

# --- Web Push notifications (see docs/NOTIFICATIONS.md) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=                    # server only
VAPID_SUBJECT=                        # e.g. mailto:admin@example.com
PUSH_SUBSCRIPTION_SECRET=             # 32+ random characters; encrypts subscriptions stored in Google Sheets
CRON_SECRET=                          # protects /api/notify/tick
# PUSH_QUIET_HOURS=22-8                # set to "off" to disable quiet hours

# --- Ad → Page rules (built in; no Google Sheets keyword entry is required) ---
# Copies Repo B's campaign aliases: danai/dr-danai and beq. When B's Page IDs differ, A resolves a unique existing Page by its name.
# Unmatched campaigns keep A's Meta Page/account fallback (unlike B's blanket default). Optional override uses actual Facebook Page IDs from A; "*" is an explicit catch-all.
# AD_PAGE_RULES=[{"fbPageId":"YOUR_META_PAGE_ID","keywords":["campaign alias"]}]
