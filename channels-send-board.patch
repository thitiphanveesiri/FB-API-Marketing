index 0000000..ec7e941
--- /dev/null
+++ b/src/app/api/send/route.ts
@@ -0,0 +1,49 @@
+import { connection, NextResponse } from "next/server";
+import { adminOnly, fail, noStore } from "@/lib/adminGate";
+import { invalidateCache } from "@/lib/sheetCache";
+import { loadChannels } from "@/lib/channels";
+import { sendMessengerText, SendError } from "@/lib/fbSend";
+import { localStamp } from "@/lib/fbSync";
+import { upsertRows } from "@/lib/sheetsWrite";
+import { channelOf } from "@/lib/types";
+
+export const maxDuration = 30;
+
+/** Administrators only. Sends a text through Messenger as the Page, then records it in the sheet's messages tab.
+ *  (Meta also echoes it to the webhook with the same message id; the "insert" mode makes that a harmless duplicate.) */
+export async function POST(req: Request) {
+  await connection();
+  const g = await adminOnly(req, true); if ("err" in g) return g.err;
+  try {
+    const b = (await req.json().catch(() => ({}))) as { leadId?: string; text?: string };
+    const text = (b.text ?? "").trim();
+    if (!b.leadId) return fail(400, "ไม่พบรหัสลูกค้า");
+    if (!text) return fail(400, "พิมพ์ข้อความก่อนส่ง");
+    if (text.length > 2000) return fail(400, "ข้อความยาวเกิน 2,000 ตัวอักษร (ข้อจำกัดของ Messenger)");
+    const lead = g.mapped.dataset.leads.find((l) => l.id === b.leadId);
+    if (!lead) return fail(404, "ไม่พบลูกค้านี้ในชีต — กด Reload from sheet แล้วลองใหม่");
+    if (channelOf(lead) !== "facebook") return fail(400, "ตอนนี้ส่งข้อความได้เฉพาะ Facebook Messenger");
+    // customers that arrived through the webhook carry the Facebook user id in their lead id; older/synced ones in fb_user_id
+    const psid = lead.fbUserId || (lead.id.startsWith("FB-") ? lead.id.slice(3) : "");
+    if (!/^\d{5,25}$/.test(psid)) return fail(400, "ยังไม่มีรหัสผู้ใช้ Facebook ของลูกค้าคนนี้ — ไปหน้า Upload กด “ดึงข้อมูลตอนนี้” อีกครั้ง หรือรอให้ลูกค้าทักมาใหม่ แล้วลองส่ง");
+    const ch = (await loadChannels(true)).find((c) => c.channel === "facebook" && c.active && c.accessToken && c.sheetPageId === lead.pageId);
+    if (!ch) return fail(400, "ยังไม่ได้เชื่อมเพจ Facebook ของลูกค้าคนนี้ — เชื่อมที่หน้า Upload ก่อน");
+
+    let sent;
+    try { sent = await sendMessengerText(ch.accessToken, psid, text, process.env.FB_GRAPH_BASE || undefined); }
+    catch (e) { if (e instanceof SendError) return fail(e.kind === "other" ? 502 : 422, e.message, { kind: e.kind }); throw e; }
+
+    // From here the customer HAS the message. A sheet failure must not look like a failed send.
+    let saved = true;
+    const at = localStamp(new Date().toISOString(), process.env.APP_TZ || "Asia/Bangkok");
+    try {
+      await upsertRows("messages", ["message_id"], [{ message_id: sent.messageId, lead_id: lead.id, direction: "out", text, sent_at: at, attachment_name: "" }], "insert");
+      await upsertRows("leads", ["lead_id"], [{ lead_id: lead.id, last_contact_at: at, last_message: text.slice(0, 300), unread: false, fb_user_id: psid, channel: "facebook" }], "updateOnly");
+      invalidateCache();
+    } catch (e) { saved = false; console.error("[api/send] sheet write failed", e instanceof Error ? e.message.replace(/EAA[\w-]{20,}/g, "…") : "error"); }
+    return NextResponse.json({ ok: true, messageId: sent.messageId, at, saved }, noStore);
+  } catch (e) {
+    console.error("[api/send]", e instanceof Error ? e.message.replace(/EAA[\w-]{20,}/g, "…") : "error");
+    return fail(502, "ส่งข้อความไม่สำเร็จ ลองใหม่อีกครั้ง");
+  }
+}
