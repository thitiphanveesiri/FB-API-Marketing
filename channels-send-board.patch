@@ -0,0 +1,30 @@
+"use client";
+import { CHANNELS, ChatChannel } from "@/lib/types";
+import { cn } from "@/components/ui";
+
+export function ChannelDot({ id, size = 8 }: { id: ChatChannel; size?: number }) {
+  return <span aria-hidden className="inline-block shrink-0 rounded-full" style={{ width: size, height: size, background: CHANNELS.find((c) => c.id === id)?.color }} />;
+}
+
+/** Chips that split chats by channel (Facebook / Instagram / LINE / WhatsApp). `counts` = chats per channel in the current view. */
+export default function ChannelFilter({ value, onChange, counts, className }: { value: ChatChannel | "all"; onChange: (v: ChatChannel | "all") => void; counts: Record<ChatChannel, number>; className?: string }) {
+  const total = CHANNELS.reduce((n, c) => n + counts[c.id], 0);
+  const base = "inline-flex items-center gap-1.5 rounded-full border px-2.5 py-1 text-xs font-medium";
+  return (
+    <div className={cn("flex flex-wrap gap-1", className)} role="group" aria-label="ช่องทางแชท">
+      <button aria-pressed={value === "all"} onClick={() => onChange("all")} className={cn(base, value === "all" ? "border-brand bg-brand-faint text-brand" : "border-line text-muted hover:bg-gray-50")}>ทุกช่องทาง <span className="opacity-70">{total}</span></button>
+      {CHANNELS.map((c) => (
+        <button key={c.id} aria-pressed={value === c.id} onClick={() => onChange(c.id)} title={counts[c.id] === 0 && c.id !== "facebook" ? "ช่องทางนี้ยังไม่ได้เชื่อมต่อ" : undefined}
+          className={cn(base, value === c.id ? "border-brand bg-brand-faint text-brand" : counts[c.id] === 0 ? "border-line text-gray-400 hover:bg-gray-50" : "border-line text-muted hover:bg-gray-50")}>
+          <ChannelDot id={c.id} />{c.label} <span className="opacity-70">{counts[c.id]}</span>
+        </button>
+      ))}
+    </div>
+  );
+}
+
+export const countByChannel = (leads: { channel?: ChatChannel }[]): Record<ChatChannel, number> => {
+  const n: Record<ChatChannel, number> = { facebook: 0, instagram: 0, line: 0, whatsapp: 0 };
+  for (const l of leads) n[l.channel ?? "facebook"]++;
+  return n;
+};
diff --git a/src/lib/fbSend.ts b/src/lib/fbSend.ts
new file mode 100644
index 0000000..6b2538e
--- /dev/null
+++ b/src/lib/fbSend.ts
@@ -0,0 +1,34 @@
+// SERVER ONLY. Send one text message to a customer through the Messenger Send API, as the Page.
+// Pure apart from the injected fetch, so the error handling can be tested without Meta.
+type FetchFn = (url: string, init?: { method?: string; headers?: Record<string, string>; body?: string }) => Promise<{ ok: boolean; status: number; json: () => Promise<unknown> }>;
+interface GErr { error?: { message?: string; code?: number; error_subcode?: number } }
+interface GOk { recipient_id?: string; message_id?: string }
+
+export type SendFailure = "window" | "permission" | "token" | "user" | "other";
+export class SendError extends Error { constructor(msg: string, public kind: SendFailure = "other", public code?: number) { super(msg); } }
+
+const scrub = (s: string) => s.replace(/EAA[\w-]{20,}/g, "…").replace(/access_token=[^&\s"']+/gi, "access_token=…");
+
+/** Meta's error → what the admin should do about it. */
+export function explainSendError(e: NonNullable<GErr["error"]>, status: number): SendError {
+  const code = e.code, sub = e.error_subcode, msg = scrub(e.message ?? `HTTP ${status}`);
+  if (code === 190) return new SendError("โทเคนของเพจหมดอายุหรือถูกเพิกถอน — เชื่อมเพจใหม่ที่หน้า Upload (วางโทเคนอายุยาว)", "token", code);
+  if (sub === 2018278 || (code === 10 && /window|24/i.test(msg))) return new SendError("ส่งไม่ได้: เกิน 24 ชั่วโมงนับจากข้อความล่าสุดของลูกค้า (Facebook ไม่อนุญาตให้ส่งข้อความหลังพ้นกรอบนี้) — ให้ลูกค้าทักมาใหม่ หรือตอบผ่าน Business Suite", "window", code);
+  if (code === 551 || sub === 1545041 || /not available|not.*found.*user|No matching user/i.test(msg)) return new SendError("ส่งไม่ได้: ไม่พบผู้ใช้นี้หรือเขาไม่รับข้อความจากเพจ (รหัสผู้ใช้อาจไม่ถูกต้อง)", "user", code);
+  if (code === 10 || code === 200 || code === 230 || code === 299) return new SendError(`ส่งไม่ได้: แอปยังไม่มีสิทธิ์ส่งข้อความหาผู้ใช้คนนี้ — ถ้าแอป Meta ยังเป็นโหมด Development จะส่งได้เฉพาะคนที่มี role ในแอป และต้องมีสิทธิ์ pages_messaging (${msg})`, "permission", code);
+  return new SendError(`Meta ตอบ ${status}: ${msg}`, "other", code);
+}
+
+export async function sendMessengerText(token: string, psid: string, text: string, base = "https://graph.facebook.com", f: FetchFn = (u, i) => fetch(u, { ...i, cache: "no-store" }) as ReturnType<FetchFn>): Promise<{ messageId: string; recipientId: string }> {
+  let r: Awaited<ReturnType<FetchFn>>;
+  try {
+    r = await f(`${base}/v21.0/me/messages?${new URLSearchParams({ access_token: token })}`, {
+      method: "POST", headers: { "Content-Type": "application/json" },
+      body: JSON.stringify({ recipient: { id: psid }, messaging_type: "RESPONSE", message: { text } }),
+    });
+  } catch { throw new SendError("เชื่อมต่อ Meta ไม่สำเร็จ ลองใหม่อีกครั้ง"); }
+  const j = ((await r.json().catch(() => ({}))) ?? {}) as GErr & GOk;
+  if (!r.ok || j.error) throw explainSendError(j.error ?? {}, r.status);
+  if (!j.message_id) throw new SendError("Meta ไม่ส่งรหัสข้อความกลับมา — ตรวจในกล่องข้อความของเพจว่าส่งแล้วหรือยัง");
+  return { messageId: j.message_id, recipientId: j.recipient_id ?? psid };
+}
